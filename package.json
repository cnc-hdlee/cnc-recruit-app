{
  "name": "cnc-recruit-app",
  "version": "2.0.97",
  "description": "CNC 채용 커맨드센터 — React + Electron",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k -n VITE,ELECTRON -c blue,green \"npm:dev:vite\" \"npm:dev:electron\"",
    "dev:vite": "vite",
    "dev:electron": "wait-on tcp:5173 && cross-env NODE_ENV=development electron .",
    "build": "vite build",
    "build:viewer": "cross-env VITE_VIEWER_MODE=true vite build --mode production",
    "sync:mobile": "npm run build:viewer && cd worker && npx --yes wrangler deploy",
    "build:portable": "vite build && electron-builder --win portable --x64",
    "build:installer": "vite build && electron-builder --win nsis --x64",
    "release": "npm version patch --no-git-tag-version && vite build && electron-builder --win nsis --x64 --publish always",
    "preview": "vite preview",
    "extract-config": "electron scripts/dump-config.cjs"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "7zip-bin": "^5.2.0",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.0.1",
    "cross-env": "^7.0.3",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "wait-on": "^8.0.1",
    "wrangler": "^4.86.0"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.0",
    "@slack/web-api": "^7.15.1",
    "electron-updater": "^6.8.3",
    "google-auth-library": "^10.6.2",
    "googleapis": "^171.4.0",
    "mammoth": "^1.12.0",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "^3.11.174",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tesseract.js": "^7.0.0"
  },
  "build": {
    "appId": "com.cnccosmetic.recruit",
    "productName": "CNC 채용",
    "npmRebuild": false,
    "buildDependenciesFromSource": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "icon.png",
      "release/.icon-ico/icon.ico"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "release/.icon-ico/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "CNC 채용",
      "deleteAppDataOnUninstall": false,
      "artifactName": "CNC-Recruit-Setup-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "cnc-hdlee",
        "repo": "cnc-recruit-app",
        "releaseType": "release"
      }
    ]
  }
}
